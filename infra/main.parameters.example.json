{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "germanywestcentral"
    },
    "resourceGroupName": {
      "value": "RG-CertDrills"
    },
    "appName": {
      "value": "certdrills"
    },
    "environmentName": {
      "value": "production"
    },
    "postgresServerFqdn": {
      "value": "<postgres-server>.postgres.database.azure.com"
    },
    "postgresRuntimeLogin": {
      "value": "<least-privilege-runtime-login>"
    },
    "postgresRuntimePassword": {
      "value": "<set-via-github-secret-postgres-runtime-password>"
    },
    "postgresDatabaseName": {
      "value": "certdrills"
    },
    "apiImage": {
      "value": "mcr.microsoft.com/azuredocs/containerapps-helloworld:latest"
    },
    "enableContainerAppProbes": {
      "value": false
    },
    "webImage": {
      "value": "mcr.microsoft.com/azuredocs/containerapps-helloworld:latest"
    },
    "adminImage": {
      "value": "mcr.microsoft.com/azuredocs/containerapps-helloworld:latest"
    },
    "alertOperatorEmail": {
      "value": "production-operator@example.com"
    }
  }
}
