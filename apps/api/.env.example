# ===========================================
# ===========================================
# API (Hono) Environment
# ===========================================

# Runtime
NODE_ENV=development
PORT=3302
LOG_LEVEL=info
# Optional local file logging directory. Leave empty to log to stdout only.
LOG_FILE_PATH=""

# In production, emit JSON logs to stdout and let infrastructure collect/rotate them.

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/db_name"

# App/API URLs
APP_URL="http://localhost:3300"
API_URL="http://localhost:3302"

# Better Auth (API side)
BETTER_AUTH_SECRET="replace-with-strong-secret"
# Optional extra allowed origins in addition to APP_URL, API_URL, and ADMIN_APP_URL.
BETTER_AUTH_ALLOWED_ORIGINS="http://localhost:3300,http://localhost:3301,http://localhost:3302"
ADMIN_APP_URL="http://localhost:3301"
ADMIN_ALLOWLIST="admin@example.com"

# Mobile JWT flow
JWT_SECRET="replace-with-strong-secret"
JWT_ISSUER="api-main"
JWT_AUDIENCE="mobile-clients"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Admin protections
# Secret required for sensitive admin actions.
ADMIN_SECRET=""
# Require every admin account to enable TOTP before accessing admin APIs.
# Production deployments default this to true; set false only for temporary testing.
ADMIN_PORTAL_TOTP_REQUIRED=true
# Required only when DODO_PAYMENTS_ENVIRONMENT=live_mode.
DODO_LIVE_MODE_APPROVED=""

# Social providers (OAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Payments
# Required to use live Dodo checkout, invoice, webhook, and discount sync flows.
DODO_PAYMENTS_API_KEY=""
# Verifies the preferred /auth/dodopayments/webhooks route and the compatibility
# /payments/webhooks/dodo route. Better Auth is mounted at /auth, not /api/auth.
DODO_PAYMENTS_WEBHOOK_SECRET=""
# Contract product IDs currently reference the Dodo test-mode catalog. Provision
# a separate live catalog and update the contracts before switching environments.
DODO_PAYMENTS_ENVIRONMENT="test_mode"
# In production with Dodo, only the brand for the active billing mode is required.
DODO_CREDITS_BRAND_ID=""
DODO_SUBSCRIPTIONS_BRAND_ID=""
DODO_TRANSACTIONS_BRAND_ID=""
# Optional bearer token for scheduled GET /billing/reconcile checks.
BILLING_RECONCILIATION_SECRET=""

# Private privacy-export object storage. Use an Azurite connection string locally;
# production receives the Azure Storage connection string through a Container App secret.
AZURE_PRIVACY_EXPORT_STORAGE_CONNECTION_STRING="UseDevelopmentStorage=true"
AZURE_PRIVACY_EXPORT_STORAGE_CONTAINER="privacy-exports"
# Azure AI Foundry content generation (optional)
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=""
AZURE_AI_FOUNDRY_API_KEY=""
AZURE_AI_FOUNDRY_MODEL=""
AZURE_AI_FOUNDRY_TIMEOUT_MS=60000


# Durable background execution
INNGEST_APP_ID="certdrills-api"
INNGEST_DEV=true
# Required in hosted environments; omit when using the local Inngest Dev Server.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
# Set during zero-downtime signing-key rotation.
INNGEST_SIGNING_KEY_FALLBACK=""

# Email
# Required for magic links, password reset, verification, and other outbound emails.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@example.com"
