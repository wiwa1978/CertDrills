# ===========================================
# Frontend (Next.js client) Environment
# ===========================================

NODE_ENV=development

# Public app config
NEXT_PUBLIC_APP_URL="http://localhost:3201"
NEXT_PUBLIC_APP_NAME="Acme Admin"
NEXT_PUBLIC_API_URL="http://localhost:8877"
NEXT_PUBLIC_MAIN_APP_URL="http://localhost:3200"

# Optional E2E credentials for authenticated Playwright runs
E2E_ADMIN_EMAIL=""
E2E_ADMIN_PASSWORD=""

# Note
# Backend secrets, database access, email, payments, Better Auth server config,
# and admin allowlist enforcement now belong to apps/api rather than apps/admin.
